{
  "name": "slideria",
  "version": "0.1.0",
  "private": true,
  "description": "Slideria — движок HTML-презентаций: презентация как данные, библиотека компонентов, сборка в один HTML-файл",
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "Slideria",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "present": "node scripts/present.mjs",
    "firewall": "node scripts/firewall.mjs",
    "preview": "vite preview",
    "new": "node scripts/new-deck.mjs",
    "merge-html": "node scripts/import.mjs",
    "import-pptx": "node scripts/import-pptx.mjs",
    "bind-theme": "node scripts/bind-theme.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && node scripts/build.mjs",
    "app": "electron .",
    "app:build": "electron-builder --win",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e",
    "test:app": "playwright test --project=app"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@google/model-viewer": "4.2.0",
    "@xmldom/xmldom": "^0.9.12",
    "codemirror": "^6.0.2",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "node-html-parser": "^9.0.4",
    "nosleep.js": "0.12.0",
    "occt-import-js": "^0.0.23",
    "pptxgenjs": "^4.0.1",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.4",
    "temml": "0.14.0",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^20",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "app.slideria",
    "productName": "Slideria",
    "directories": {
      "output": "dist-app"
    },
    "asar": false,
    "npmRebuild": false,
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "files": [
      "index.html",
      "vite.config.ts",
      "tsconfig.json",
      "package.json",
      "desktop/**",
      "src/**",
      "plugins/**",
      "scripts/**",
      "templates/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Slideria"
    },
    "mac": {
      "icon": "desktop/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "desktop/icon.png"
    }
  }
}
