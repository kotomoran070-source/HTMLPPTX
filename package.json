{
  "name": "slideria",
  "version": "0.1.0",
  "private": true,
  "description": "Slideria — движок HTML-презентаций: презентация как данные, библиотека компонентов, сборка в один HTML-файл",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "present": "node scripts/present.mjs",
    "preview": "vite preview",
    "new": "node scripts/new-deck.mjs",
    "merge-html": "node scripts/import.mjs",
    "bind-theme": "node scripts/bind-theme.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && node scripts/build.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "4.2.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^20",
    "codemirror": "^6.0.2",
    "node-html-parser": "^9.0.4",
    "occt-import-js": "^0.0.23",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "yaml": "^2.9.1"
  }
}
